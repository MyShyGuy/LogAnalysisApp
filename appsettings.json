{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "LogAnalysis": {
    "PollingIntervalMinutes": 2,
    "StateFilePath": "State/scanner-state.json",
    "ErrorLogPath": "Log/LmsErrorLog.log",
    "HeaderRegexPattern": "^(?<date>\\d{4}-\\d{2}-\\d{2}\\s\\d{2}:\\d{2}:\\d{2}(?:[.,]\\d+)?)\\s.*?\\b(?<level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL)\\b",
    "Sources": [
      { "Name": "Gateway", "Path": "../Gateway/Log/Gateway.log" },
      { "Name": "ConfigurationService", "Path": "../Configuration/Log/ConfigurationService.log" },
      { "Name": "UserManagement", "Path": "../UserManagement/log/Krones.Lms.UserManagement.log" },
      { "Name": "MasterData", "Path": "../MasterData/Log/MasterData.log" },
      { "Name": "FrameworkService", "Path": "../FrameworkService/Log/LmsFwService.log" },
      { "Name": "Wap", "Path": "../Wap.Core.Host/log/Wap.log" },
      { "Name": "B2MML", "Path": "../B2MML/Log/B2MMLService.log" },
      { "Name": "OrderManagement", "Path": "../OrderManagement/Log/OrderManagementService.log" },
      { "Name": "OrderAndEquipmentCoordinator", "Path": "../Oec/Log/OEC.log" },
      { "Name": "OrderStateServer", "Path": "../OrderStateServer/Log/OrderState.log" },
      { "Name": "TouchService", "Path": "../TouchMicroservice/Log/Touch.log" },
      { "Name": "DAS", "Path": "../DAS-Windows-WriteEnabled-14.16.0/log/DAS.log" },
      { "Name": "MachineConnector", "Path": "../MachineConnector/Log/MachineConnector.log" },
      { "Name": "MIA", "Path": "../MainInterfaceApplicationV2/Log/MainInterfaceApplication.log" }
    ]
  }
}
